import sqlite3

conexao= sqlite3.connect("meubanco.db")
cursor = conexao.cursor()

cursor.execute("""
    CREATE TABLE IF NOT EXISTS tabela_relacionada(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        usuario_id INTEGER NOT NULL,
        curso_id INTEGER NOT NULL,
        FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE
    )
""")
cursor.execute("""
    INSERT INTO tabela_relacionada (usuario_id, curso_id)
    SELECT usuarios.id, cursos.id
    FROM usuarios, cursos

    WHERE usuarios.status = 'inativo' AND cursos.cursos = 'Eng de produção'
    """)
print("Tabelas relacionada com sucesso!")
conexao.commit()
conexao.close()